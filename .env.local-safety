# LOCAL DEVELOPMENT ONLY -- not production, not the droplet.
#
# This file exists so that the local stack can NEVER reach a real router,
# even by accident. The local machine sits on the same LAN as the live
# MikroTik routers (172.30.120.1/.2/.3), so "it is only a dev container" is
# not a safety property. These values ARE the safety property.
#
# Copy to .env before running `docker compose up` locally:
#     Copy-Item .env.local-safety .env

# --- ROUTER SAFETY -------------------------------------------------------
# read_only: every write path refuses and logs. Not "live", not "dry_run".
ROUTER_MODE=read_only

# Two-key arming stays unarmed. With ROUTER_MODE flipped by mistake these
# still have to be set deliberately, so a single variable cannot open a
# router. Both left blank on purpose -- NEVER put real values in this file.
ROUTER_WRITE_TOKEN=
ROUTER_WRITE_TOKEN_EXPECTED=

# --- LOCAL SERVICE WIRING ------------------------------------------------
DATABASE_URL=postgres://gametech_user:gametech_pass@db:5432/gametech_db
CELERY_BROKER_URL=redis://redis:6379/0

# Dev-only key. This stack is not published anywhere.
SECRET_KEY=local-dev-only-not-a-real-secret-key-0000
DEBUG=True
ALLOWED_HOSTS=*

INCENTIVES_ENABLED=False